+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 0),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "pwm0_0")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 1),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "pwm0_1")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 2),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "pwm0_2")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 3),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "pwm0_3")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 4),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "i2s1")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 5),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "i2s1")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 6),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "i2s1")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 7),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "i2s1")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 8),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "dmic")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 9),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "dmic")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 10),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "pdm")),
+	SUNXI_PIN(SUNXI_PINCTRL_PIN(K, 11),
+		SUNXI_FUNCTION(0x0, "gpio_in"),
+		SUNXI_FUNCTION(0x1, "gpio_out"),
+		SUNXI_FUNCTION(0x2, "pdm")),
+};
+
+/*
+ * Bank base offsets. Each bank is indexed relative to bank A.
+ * PA=0, PB=1, PC=2, PD=3, PE=4, PF=5, PG=6, PH=7, PI=8, PJ=9, PK=10.
+ */
+/* Bank base offsets: PA=0, PB=1, PC=2, PD=3, PE=4, PF=5, PG=6, PH=7, PI=8, PJ=9, PK=10 */
+
+/*
+ * IRQ-capable banks: PB through PJ (9 banks).
+ * Maps software IRQ bank index -> hardware bank offset.
+ */
+static const unsigned int a733_irq_bank_map[] = { 1, 2, 3, 4, 5, 6, 7, 8, 9 };
+
+static const struct sunxi_pinctrl_desc a733_pinctrl_data = {
+	.pins			= a733_pins,
+	.npins			= ARRAY_SIZE(a733_pins),
+	.irq_banks		= ARRAY_SIZE(a733_irq_bank_map),
+	.irq_bank_map		= a733_irq_bank_map,
+};
+
+static int a733_pinctrl_probe(struct platform_device *pdev)
+{
+	return sunxi_pinctrl_init(pdev, &a733_pinctrl_data);
+}
+
+static const struct of_device_id a733_pinctrl_match[] = {
+	{ .compatible = "allwinner,sun60i-a733-pinctrl", },
+	{}
+};
+MODULE_DEVICE_TABLE(of, a733_pinctrl_match);
+
+static struct platform_driver a733_pinctrl_driver = {
+	.probe	= a733_pinctrl_probe,
+	.driver	= {
+		.name		= "sun60i-a733-pinctrl",
+		.of_match_table	= a733_pinctrl_match,
+	},
+};
+
+static int __init a733_pio_init(void)
+{
+	return platform_driver_register(&a733_pinctrl_driver);
+}
+postcore_initcall(a733_pio_init);
+
+MODULE_DESCRIPTION("Allwinner A733 pio pinctrl driver");
+MODULE_LICENSE("GPL");
+MODULE_VERSION(A733_PINCTRL_VERSION);
