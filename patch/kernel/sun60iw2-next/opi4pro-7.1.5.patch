diff --git a/init/main.c b/init/main.c
index 96f93bb..d097e2d 100644
--- a/init/main.c
+++ b/init/main.c
@@ -1013,12 +1013,28 @@ static void __init print_kernel_cmdline(const char *cmdline)
 		pr_notice("%s%s\n", KERNEL_CMDLINE_PREFIX, cmdline);
 }
 
+static inline void putc_idmap(char c)
+{
+	asm volatile(
+		"mov x9, #0x02500000\n"
+		"99: ldr w10, [x9, #0x14]\n"
+		"tbz w10, #5, 99b\n"
+		"mov w10, %w0\n"
+		"str w10, [x9]\n"
+		:
+		: "r" ((unsigned long)c)
+		: "x9", "x10", "memory"
+	);
+}
+
 asmlinkage __visible __init __no_sanitize_address __noreturn __no_stack_protector
 void start_kernel(void)
 {
 	char *command_line;
 	char *after_dashes;
 
+	putc_idmap('E');
+
 	set_task_stack_end_magic(&init_task);
 	smp_setup_processor_id();
 	debug_objects_early_init();
