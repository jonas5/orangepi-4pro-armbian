+			compatible = "allwinner,sun60i-a733-ehci",
+				     "allwinner,sun8i-h3-ehci";
+			reg = <0x04200000 0xfff>,
+			      <0x00000000 0x100>,
+			      <0x04100000 0x1000>;
+			interrupts = <GIC_SPI 159 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_USB1_EHCI>;
+			resets = <&ccu RST_USB1_EHCI>;
+			phys = <&usbphy 2>;
+			phy-names = "usb";
+			status = "disabled";
+		};
+
+		ohci1: ohci@4200400 {
+			compatible = "allwinner,sun60i-a733-ohci",
+				     "allwinner,sun8i-h3-ohci";
+			reg = <0x04200400 0xfff>,
+			      <0x00000000 0x100>,
+			      <0x04100000 0x1000>;
+			interrupts = <GIC_SPI 160 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_USB1_OHCI>;
+			resets = <&ccu RST_USB1_OHCI>;
+			phys = <&usbphy 2>;
+			phy-names = "usb";
+			status = "disabled";
+		};
+
+		dwc3: dwc3@6a00000 {
+			compatible = "snps,dwc3";
+			reg = <0x06a00000 0x100000>;
+			interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_USB2_MF>;
+			clock-names = "bus_clk";
+			resets = <&ccu RST_USB2>;
+			reset-names = "dwc3";
+			phys = <&usbphy 3>;
+			phy-names = "usb3-phy";
+			dr_mode = "otg";
+		maximum-speed = "super-speed-plus";
+			usb-role-switch;
+			status = "disabled";
+		};
+
+		pcie: pcie@6000000 {
+			compatible = "allwinner,sun60i-a733-pcie";
+			reg = <0x06000000 0x480000>;
+			reg-names = "dbi";
+			interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 153 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 136 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 138 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 139 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "sii", "msi",
+					  "edma-w0", "edma-w1",
+					  "edma-w2", "edma-w3",
+					  "edma-r0", "edma-r1",
+					  "edma-r2", "edma-r3";
+			clocks = <&ccu CLK_PCIE0_AUX>,
+				 <&ccu CLK_PCIE0_AXI_SLV>;
+			clock-names = "pclk_aux", "pclk_slv";
+			resets = <&ccu RST_BUS_PCIE0>;
+			reset-names = "pclk_rst";
+			phys = <&serdes0_phy PHY_TYPE_PCIE 0>;
+			phy-names = "pcie-phy";
+			power-domains = <&pck 1>;
+			status = "disabled";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			device_type = "pci";
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &gic 0 GIC_SPI 136 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 2 &gic 0 GIC_SPI 137 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 3 &gic 0 GIC_SPI 138 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 4 &gic 0 GIC_SPI 139 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 5 &gic 0 GIC_SPI 140 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 6 &gic 0 GIC_SPI 141 IRQ_TYPE_LEVEL_HIGH>,
+					<0 0 0 7 &gic 0 GIC_SPI 142 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		gmac0: ethernet@4500000 {
+			compatible = "allwinner,sun60i-a733-gmac",
+				     "allwinner,sun50i-r329-gmac",
+				     "snps,dwmac-5.20";
+			reg = <0x04500000 0x8000>,
+			      <0x04508000 0x1000>;
+			reg-names = "mac", "mtl";
+			interrupts = <GIC_SPI 172 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "macirq";
+			clocks = <&ccu CLK_GMAC0>,
+				 <&ccu CLK_GMAC0_MBUS>,
+				 <&ccu CLK_GMAC0_PHY>,
+				 <&ccu CLK_GMAC_PTP>;
+			clock-names = "stmmaceth", "pclk", "phy",
+				      "ptp_ref";
+			resets = <&ccu RST_BUS_GMAC0_AXI>,
+				 <&ccu RST_BUS_GMAC0>;
+			reset-names = "stmmaceth", "ahb";
+			phy-mode = "rgmii";
+			phy-handle = <&ext_gmac0_phy>;
+			status = "disabled";
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			mdio0: mdio {
+				compatible = "snps,dwmac-mdio";
+				#address-cells = <1>;
+				#size-cells = <0>;
+			};
+		};
+
+		npu: npu@3600000 {
+			compatible = "allwinner,sun60i-a733-npu";
+			reg = <0x03600000 0x1000>;
+			interrupts = <GIC_SPI 65 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&ccu CLK_NPU>, <&ccu CLK_PLL_NPU>,
+				 <&ccu CLK_BUS_NPU>;
+			clock-names = "clk", "clk_parent", "clk_bus";
+			resets = <&ccu RST_BUS_NPU>;
+			status = "disabled";
+		};
+
+		gpu: gpu@1800000 {
+			compatible = "allwinner,sun60i-a733-mali",
+				     "arm,mali-bifrost";
+			reg = <0x01800000 0x8ffff>;
+			interrupts = <GIC_SPI 63 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 64 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "gp", "gpmmu", "pp0";
+			clocks = <&ccu CLK_PLL_GPU>, <&ccu CLK_GPU>,
+				 <&ccu CLK_BUS_GPU>;
+			clock-names = "clk_mali", "clk_mali_bus",
+				      "clk_bus_mali";
+			resets = <&ccu RST_BUS_GPU>;
+			operating-points-v2 = <&gpu_opp_table>;
+			power-domains = <&pck 2>;
+			#cooling-cells = <2>;
+
+			gpu_opp_table: opp-table {
+				compatible = "operating-points-v2";
+				opp-shared;
+			};
+		};
+
+		serdes0_phy: phy@6c00000 {
+			compatible = "allwinner,sun60i-a733-serdes";
+			reg = <0x06c00000 0x10000>;
+			clocks = <&ccu CLK_PLL_PERI0_400M>, <&osc24M>;
+			clock-names = "refclk", "sysclk";
+			resets = <&ccu RST_USB0>;
+			#phy-cells = <2>;
+			status = "okay";
+		};
+
+		nsi: nsi@2020000 {
+			compatible = "allwinner,sunxi-nsi-v2";
+			interrupts = <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
+			reg = <0x02020000 0x10000>,
+			      <0x0A030000 0x20000>;
+			clocks = <&ccu 0>, <&ccu 1>, <&ccu 2>,
+				 <&ccu 3>, <&ccu 4>, <&ccu 5>,
+				 <&ccu 6>, <&ccu 7>;
+			#nsi-cells = <1>;
+		};
+
+		dsufreq: dsufreq@8860000 {
+			compatible = "allwinner,sun60i-a733-dsufreq";
+			reg = <0x08860000 0x1000>;
+		};
+
+		cpupll_ccu: cpupll-ccu@8870000 {
+			compatible = "allwinner,sun60i-a733-cpupll";
+			reg = <0x08870000 0x3034>;
+			clocks = <&rtc_ccu 0>;
+			clock-names = "dcxo";
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		rtc_ccu: rtc-ccu@7090000 {
+			compatible = "allwinner,sun60i-a733-rtc-ccu";
+			reg = <0x07090000 0x400>;
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+		};
+
+		r_ccu: r-ccu@7010000 {
+			compatible = "allwinner,sun60i-a733-r-ccu";
+			reg = <0x07010000 0x340>;
+			clocks = <&osc24M>,
+				 <&rtc_ccu 0>,
+				 <&rc_16m>,
+				 <&ccu CLK_PLL_PERI0_200M>,
+				 <&ccu CLK_PLL_AUDIO0_4X>;
+			clock-names = "hosc",
+				      "losc",
+				      "iosc",
+				      "pll-periph",
+				      "pll-audio";
+			#clock-cells = <1>;
+			#reset-cells = <1>;
+			assigned-clocks = <&r_ccu CLK_R_AHB>,
+					   <&r_ccu CLK_R_APB0>;
+			assigned-clock-rates = <200000000>, <100000000>;
+		};
+
+		nmi_intc: nmi-intc@7010320 {
+			compatible = "allwinner,sun60i-a733-nmi",
+				     "allwinner,sun9i-a80-nmi";
+			reg = <0x07010320 0xc>;
+			interrupts = <GIC_SPI 188 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-controller;
+			#interrupt-cells = <2>;
+		};
+
+		r_i2c0: i2c@7083000 {
+			compatible = "allwinner,sun60i-a733-i2c",
+				     "allwinner,sun8i-v536-i2c",
+				     "allwinner,sun6i-a31-i2c";
+			reg = <0x07083000 0x400>;
+			interrupts = <GIC_SPI 203 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&r_ccu CLK_R_TWI0>;
+			resets = <&r_ccu RST_BUS_R_TWI0>;
+			dmas = <&dma 47>, <&dma 47>;
+			dma-names = "rx", "tx";
+			pinctrl-names = "default";
+			pinctrl-0 = <&r_i2c0_pins>;
+			status = "disabled";
+			#address-cells = <1>;
+			#size-cells = <0>;
+		};
+
+		rtc: rtc@7090000 {
+			compatible = "allwinner,sun60i-a733-rtc",
+				     "allwinner,sun6i-a31-rtc";
+			reg = <0x07090000 0x320>;
+			interrupts = <GIC_SPI 196 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&r_ccu CLK_R_AHB>,
+				 <&rtc_ccu CLK_RTC_1K>,
+				 <&rtc_ccu CLK_RTC_SPI>;
+			clock-names = "r-ahb-rtc", "rtc-1k", "rtc-spi";
+			resets = <&r_ccu RST_BUS_RTC>;
+			#clock-cells = <1>;
+			status = "disabled";
+		};
+
+		pck: power-controller@7060000 {
+			compatible = "allwinner,sun60i-a733-power-controller",
+				     "syscon", "simple-mfd";
+			reg = <0x07060000 0xb000>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			#power-domain-cells = <1>;
+
+			pck_usb: power-domain@0 {
+				compatible = "allwinner,sun60i-a733-pd-usb";
+				reg = <0>;
+				#power-domain-cells = <0>;
+				clocks = <&ccu CLK_USB0>,
+					 <&ccu CLK_USB1>,
+					 <&ccu CLK_USB2>;
+				resets = <&ccu RST_USB0>,
+					 <&ccu RST_USB1>,
+					 <&ccu RST_USB2>;
+			};
+
+			pck_de: power-domain@1 {
+				compatible = "allwinner,sun60i-a733-pd-de";
+				reg = <1>;
+				#power-domain-cells = <0>;
+				clocks = <&ccu CLK_DE>,
+					 <&ccu CLK_BUS_DE>;
+				resets = <&ccu RST_BUS_DE>;
+			};
+
+			pck_gpu: power-domain@2 {
+				compatible = "allwinner,sun60i-a733-pd-gpu";
+				reg = <2>;
+				#power-domain-cells = <0>;
+				clocks = <&ccu CLK_GPU>;
+				resets = <&ccu RST_BUS_GPU>;
+			};
+
+			pck_pcie: power-domain@3 {
+				compatible = "allwinner,sun60i-a733-pd-pcie";
+				reg = <3>;
+				#power-domain-cells = <0>;
+				clocks = <&ccu CLK_PCIE0_AUX>,
+					 <&ccu CLK_PCIE0_AXI_SLV>;
+				resets = <&ccu RST_BUS_PCIE0>;
+			};
+
+			r_ppu0: r-ppu@1000 {
+				compatible = "allwinner,sunxi-r-ppu-v1";
+				reg = <0x1000>;
+				interrupts = <GIC_SPI 195 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&r_ccu CLK_R_PPU>;
+				clock-names = "r-ppu";
+				resets = <&r_ccu RST_BUS_R_PPU0>;
+				power-domains = <&pck_pcie>;
+			};
+
+			r_ppu1: r-ppu@1400 {
+				compatible = "allwinner,sunxi-r-ppu-v1";
+				reg = <0x1400>;
+				interrupts = <GIC_SPI 197 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&r_ccu CLK_R_PPU>;
+				clock-names = "r-ppu";
+				resets = <&r_ccu RST_BUS_R_PPU1>;
+				#power-domain-cells = <1>;
+			};
+		};
+
+		sunxi-dram-freq@2020000 {
+			compatible = "allwinner,sun60i-a733-dramfreq";
+			reg = <0x02020000 0x10000>;
+			clocks = <&ccu CLK_PLL_DDR>, <&ccu CLK_PLL_DDR1>;
+			clock-names = "pll-ddr0", "pll-ddr1";
+			status = "disabled";
+		};
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
+	};
+};
diff --git a/arch/arm64/configs/orangepi_4pro_defconfig b/arch/arm64/configs/orangepi_4pro_defconfig
new file mode 100644
index 000000000..af723a23e
--- /dev/null
+++ b/arch/arm64/configs/orangepi_4pro_defconfig
@@ -0,0 +1,262 @@
+#
+# Orange Pi 4 Pro - Allwinner A733 (sun60i) minimal bootable config
+# Based on arch/arm64/configs/defconfig, trimmed to sun60i essentials.
+#
+# NOTE: verified symbol names in this tree:
+#   - A733 CCU        : CONFIG_SUN60I_CCU (under CONFIG_SUNXI_CCU)
+#   - A733 pinctrl    : CONFIG_AW_PINCTRL_SUN60IW2 (selects PINCTRL_SUNXI)
+#   - A733 audio      : CONFIG_SND_SUN60I_SOC
+#   - A733 GMAC       : CONFIG_SUN60I_GMAC
+#   - SD/MMC          : CONFIG_MMC_SUNXI (no MMC_SUN20I_D1 in tree)
+#   - Motorcomm PHY   : CONFIG_MOTORCOMM_PHY (not PHY_MOTORCOMM)
+#   - No PHY_SUN60I_SERDES exists; only USB3 and PCIE PHYs.
+#   - ARCH_SUN60IW2 does not exist; ARCH_SUNXI covers it.
+#
+# Deliberately excluded (do not compile / BSP-only):
+#   - CONFIG_DRM_SUN60I            (DRM API incompatibilities)
+#   - CONFIG_CRYPTO_DEV_SUN60I_CE  (missing header)
+#   - CONFIG_SUN60I_THERMAL        (thermal API changed)
+#   - CONFIG_SND_SOC_AW_SUN60IW2_* (BSP-only DAI/DMA/PCM/SNDWIRE)
+#
+
+# ---------- Core kernel ----------
+CONFIG_SYSVIPC=y
+CONFIG_POSIX_MQUEUE=y
+CONFIG_NO_HZ_IDLE=y
+CONFIG_HIGH_RES_TIMERS=y
+CONFIG_BPF_SYSCALL=y
+CONFIG_PREEMPT=y
+CONFIG_IRQ_TIME_ACCOUNTING=y
+CONFIG_IKCONFIG=y
+CONFIG_IKCONFIG_PROC=y
+CONFIG_LOG_BUF_SHIFT=18
+CONFIG_MEMCG=y
+CONFIG_BLK_CGROUP=y
+CONFIG_CGROUP_PIDS=y
+CONFIG_CGROUP_FREEZER=y
+CONFIG_CGROUP_DEVICE=y
+CONFIG_CGROUP_CPUACCT=y
+CONFIG_CGROUP_PERF=y
+CONFIG_USER_NS=y
+CONFIG_SCHED_AUTOGROUP=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_KALLSYMS_ALL=y
+CONFIG_PROFILING=y
+CONFIG_MODULES=y
+CONFIG_MODULE_UNLOAD=y
+
+# ---------- Architecture / platform ----------
+CONFIG_ARCH_SUNXI=y
+CONFIG_COMPAT_32BIT_TIME=y
+CONFIG_RANDOMIZE_BASE=y
+CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
+CONFIG_ARM_PSCI_CPUIDLE=y
+CONFIG_CPU_IDLE=y
+CONFIG_CPU_FREQ=y
+CONFIG_CPU_FREQ_STAT=y
+CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
+CONFIG_CPUFREQ_DT=y
+CONFIG_JUMP_LABEL=y
+
+# ---------- Kernel image ----------
+CONFIG_DEFAULT_HOSTNAME="(none)"
+# NOTE: no HAVE_KERNEL_GZIP on this arm64 tree; kernel compression
+# mode choice is not available, so no CONFIG_KERNEL_GZIP here.
+# CONFIG_COMPAT_BRK is not set
+
+# ---------- Memory ----------
+CONFIG_TRANSPARENT_HUGEPAGE=y
+CONFIG_KSM=y
+CONFIG_CMA=y
+CONFIG_DMA_CMA=y
+CONFIG_CMA_SIZE_MBYTES=32
+
+# ---------- Networking ----------
+CONFIG_NET=y
+CONFIG_PACKET=y
+CONFIG_UNIX=y
+CONFIG_INET=y
+CONFIG_IP_MULTICAST=y
+CONFIG_IP_PNP=y
+CONFIG_IP_PNP_DHCP=y
+CONFIG_IP_PNP_BOOTP=y
+CONFIG_IPV6=y
+CONFIG_SYN_COOKIES=y
+CONFIG_BRIDGE=m
+CONFIG_VLAN_8021Q=m
+
+# ---------- Ethernet: sun60i GMAC ----------
+# NOTE: SUN60I_GMAC lives inside "if STMMAC_PLATFORM" within "if STMMAC_ETH",
+# so both parents must be enabled for it to be visible.
+CONFIG_NETDEVICES=y
+CONFIG_ETHERNET=y
+CONFIG_STMMAC_ETH=y
+CONFIG_STMMAC_PLATFORM=y
+CONFIG_SUN60I_GMAC=y
+CONFIG_PHYLIB=y
+CONFIG_MOTORCOMM_PHY=y
+CONFIG_FIXED_PHY=y
+
+# ---------- MMC / SD (rootfs device) ----------
+CONFIG_MMC=y
+CONFIG_MMC_BLOCK=y
+CONFIG_MMC_BLOCK_MINORS=32
+CONFIG_MMC_SUNXI=y
+
+# ---------- Wireless (modules) ----------
+CONFIG_CFG80211=m
+CONFIG_MAC80211=m
+CONFIG_RFKILL=m
+
+# ---------- Firmware / devtmpfs ----------
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_FW_LOADER_USER_HELPER=y
+CONFIG_ARM_SCMI_PROTOCOL=y
+
+# ---------- Serial console (DesignWare 8250) ----------
+CONFIG_SERIAL_8250=y
+CONFIG_SERIAL_8250_CONSOLE=y
+CONFIG_SERIAL_8250_NR_UARTS=8
+CONFIG_SERIAL_8250_EXTENDED=y
+CONFIG_SERIAL_8250_SHARE_IRQ=y
+CONFIG_SERIAL_8250_DW=y
+CONFIG_SERIAL_OF_PLATFORM=y
+CONFIG_SERIAL_DEV_BUS=y
+CONFIG_SERIAL_EARLYCON=y
+
+# ---------- Early boot debugging ----------
+CONFIG_CMDLINE="console=ttyS2,115200n8"
+CONFIG_DEBUG_INFO=y
+CONFIG_DEBUG_INFO_DWARF5=y
+
+# ---------- GPIO / pinctrl ----------
+CONFIG_AW_PINCTRL_SUN60IW2=y
+
+# ---------- Clocks / reset / timers ----------
+CONFIG_COMMON_CLK=y
+CONFIG_SUNXI_CCU=y
+CONFIG_SUN60I_CCU=y
+
+# ---------- I2C (AXP8191 PMIC bus) ----------
+CONFIG_I2C=y
+CONFIG_I2C_CHARDEV=y
+CONFIG_I2C_MUX=y
+CONFIG_I2C_MV64XXX=y
+
+# ---------- SPI ----------
+CONFIG_SPI=y
+CONFIG_SPI_SUN6I=y
+CONFIG_SPI_SPIDEV=m
+
+# ---------- MFD / regulators (AXP8191 PMIC) ----------
+CONFIG_MFD_AXP8191=y
+CONFIG_REGULATOR=y
+CONFIG_REGULATOR_FIXED_VOLTAGE=y
+CONFIG_REGULATOR_AXP8191=y
+
+# ---------- Power / reset ----------
+CONFIG_POWER_RESET_SYSCON=y
+CONFIG_SYSCON_REBOOT_MODE=y
+
+# ---------- Watchdog ----------
+CONFIG_WATCHDOG=y
+CONFIG_SUNXI_WATCHDOG=y
+
+# ---------- RTC ----------
+CONFIG_RTC_CLASS=y
+CONFIG_RTC_DRV_SUN6I=y
+
+# ---------- DMA engine ----------
+CONFIG_DMADEVICES=y
+CONFIG_DMA_SUN6I=y
+
+# ---------- NVMEM ----------
+CONFIG_NVMEM=y
+CONFIG_NVMEM_SUNXI_SID=y
+
+# ---------- PHYs ----------
+CONFIG_GENERIC_PHY=y
+CONFIG_PHY_SUN60I_USB3=y
+CONFIG_PHY_SUN60I_PCIE=y
+
+# ---------- USB ----------
+CONFIG_USB=y
+CONFIG_USB_XHCI_HCD=y
+CONFIG_USB_XHCI_PLATFORM=y
+CONFIG_USB_EHCI_HCD=y
+CONFIG_USB_EHCI_HCD_PLATFORM=y
+CONFIG_USB_OHCI_HCD=y
+CONFIG_USB_OHCI_HCD_PLATFORM=y
+CONFIG_USB_STORAGE=y
+CONFIG_USB_ACM=m
+CONFIG_USB_SERIAL=m
+CONFIG_NOP_USB_XCEIV=y
+
+# ---------- SCSI (USB storage / sd) ----------
+CONFIG_SCSI=y
+CONFIG_BLK_DEV_SD=y
+
+# ---------- PCI host ----------
+CONFIG_PCI=y
+CONFIG_PCI_HOST_GENERIC=y
+
+# ---------- Input ----------
+CONFIG_INPUT=y
+CONFIG_INPUT_EVDEV=y
+CONFIG_KEYBOARD_GPIO=y
+
+# ---------- Thermal framework (no sun60i sensor driver) ----------
+CONFIG_THERMAL=y
+CONFIG_CPU_THERMAL=y
+CONFIG_THERMAL_GOV_STEP_WISE=y
+# CONFIG_SUN60I_THERMAL is not set
+
+# ---------- Sound (sun60i ASoC) ----------
+CONFIG_SOUND=y
+CONFIG_SND=y
+CONFIG_SND_TIMER=y
+CONFIG_SND_PCM=y
+CONFIG_SND_JACK=y
+CONFIG_SND_SOC=y
+CONFIG_SND_SUN60I_SOC=y
+CONFIG_SND_SIMPLE_CARD=y
+CONFIG_SND_SIMPLE_CARD_UTILS=y
+# BSP-only drivers not present in mainline:
+# CONFIG_SND_SOC_AW_SUN60IW2_DAI is not set
